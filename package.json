{
  "name": "southern-spoon-pos",
  "productName": "Southern Spoon POS",
  "private": true,
  "version": "1.0.0",
  "description": "Southern Spoon Restaurant POS - Offline Desktop System",
  "author": "Southern Spoon",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:ts": "tsc -p tsconfig.electron.json && node -e \"fs.writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'}))\"",
    "electron:dev": "npm run electron:ts && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && npm run electron:ts && electron-builder --win"
  },
  "build": {
    "appId": "com.southernspoon.pos",
    "productName": "Southern Spoon POS",
    "copyright": "Copyright © 2026 Southern Spoon Galle",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Southern Spoon POS"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
